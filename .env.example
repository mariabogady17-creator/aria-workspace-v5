# A.R.I.A. Workspace - configuración local

# Gemini API key principal (requerida para el chat)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Keys Gemini adicionales para la cadena de fallback (opcional)
# Cuando una key falla (límite/cuota/timeout), A.R.I.A. rota automáticamente a la siguiente.
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""

# Puerto del servidor local (default 3000)
# ARIA_PORT=3000

# Ruta al directorio de skills (default: ../opencode-skills-125)
# ARIA_SKILLS_DIR="C:\Users\NB-5200\Desktop\APP CODE\A.R.I.A\ARIA V5GIT\FUSION NUEVO\fusion mejoras (1)\fusion mejoras\opencode-skills-125"

# Ruta a cloudflared.exe para el enlace remoto (default: ../cloudflared.exe)
# CLOUDFLARED_PATH="C:\Users\NB-5200\Desktop\APP CODE\A.R.I.A\ARIA V5GIT\FUSION NUEVO\fusion mejoras (1)\fusion mejoras\cloudflared.exe"

# APP_URL: URL pública donde se aloja la app (solo despliegue)
APP_URL="MY_APP_URL"
